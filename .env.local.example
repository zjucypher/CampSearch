# Supabase — copy from your project's API settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Site URL (used for redirects)
NEXT_PUBLIC_SITE_URL=https://campsearch.vercel.app

# Resend — transactional email
RESEND_API_KEY=re_...

# Stripe — billing
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_RANGER_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Internal worker → Next.js auth
WORKER_SECRET=your-random-secret-here

# Twilio — SMS (Pro/Ranger plan only)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1...
